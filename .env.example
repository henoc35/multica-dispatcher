# Connexion à Multica (valeurs de DÉMO : remplace-les)
# server_url et token sont dans ~/.multica/config.json de ta machine.
MULTICA_SERVER_URL=https://api.multica.ai
MULTICA_TOKEN=mat_demo_0123456789abcdef

# Workspaces suivis :
#   all (défaut)        = tous les workspaces accessibles avec ce token, y compris ceux créés plus tard
#   alpha,beta          = liste de slugs ou d'identifiants, séparés par des virgules
MULTICA_WORKSPACES=all
# Workspaces à ignorer avec « all » (slugs ou identifiants), par exemple un projet archivé.
EXCLUDE_WORKSPACES=
# Ancien réglage mono-workspace, encore accepté si MULTICA_WORKSPACES est vide.
# MULTICA_WORKSPACE_ID=00000000-0000-4000-8000-000000000000
# Optionnel : adresse WebSocket si elle diffère de MULTICA_SERVER_URL + /ws
MULTICA_WS_URL=

# 1 = simulation (journalise ce qu'il ferait, ne lance rien). Passe à 0 une fois vérifié.
DRY_RUN=1

# Agents gérés, séparés par des virgules. Vide = tous les agents de chaque workspace.
#   qa-lead       = cet agent dans tous les workspaces
#   beta/qa-lead  = cet agent dans le workspace « beta » seulement
AGENTS=
# Agents qui traitent la relecture : leurs issues « En relecture » sont aussi relancées.
REVIEWER_AGENTS=qa-lead,security-lead,seo-lead
# Relectures restées chez l'agent qui a fait le travail : confiées à cet agent, dans la limite
# de ses places libres (les suivantes partent dès qu'une relecture se termine).
# Vide = le service ne change jamais le responsable d'une issue.
REVIEW_ASSIGNEE=qa-lead
# Au-delà de ce nombre d'issues en relecture DANS UN WORKSPACE : aucune nouvelle tâche
# « À faire » ne démarre dans ce workspace. Les autres workspaces ne sont pas touchés.
REVIEW_PRIORITY_LIMIT=10
# Colonnes personnalisées jamais relancées (elles attendent un humain).
EXCLUDE_STATUS_REGEX=question|test

# Filets de sécurité
# Rattrapage, et découverte des nouveaux workspaces, toutes les N secondes.
RECONCILE_SECONDS=60
MAX_DISPATCH_PER_AGENT_PER_HOUR=20
MAX_DISPATCH_PER_ISSUE_PER_DAY=8
ISSUE_COOLDOWN_SECONDS=300
NO_PROGRESS_LIMIT=3
ACTIVITY_GRACE_SECONDS=120
FAILURE_BREAKER_COUNT=3
FAILURE_BREAKER_WINDOW=600
FAILURE_BREAKER_PAUSE=900

LOG_LEVEL=INFO
